import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3
from pathlib import Path
import os


class DatabaseManager:
    """Handles all database operations"""

    def __init__(self, db_name="pythontut.db"):
        self.db_name = db_name
        self.init_database()

    def init_database(self):
        """Initialize database and create table if it doesn't exist"""
        try:
            # Delete old database if it exists to avoid schema conflicts
            if os.path.exists(self.db_name):
                os.remove(self.db_name)

            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()

                # Create new table with correct schema
                cursor.execute("""
                CREATE TABLE IF NOT EXISTS member (
                    mem_id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
                    firstname TEXT NOT NULL,
                    lastname TEXT NOT NULL,
                    age INTEGER NOT NULL,
                    gender TEXT NOT NULL,
                    address TEXT NOT NULL,
                    username TEXT NOT NULL,
                    password TEXT NOT NULL
                )
                """)
                conn.commit()

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to initialize database: {e}")

    def insert_member(self, firstname, lastname, age, gender, address, username, password):
        """Insert a new member into the database"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                INSERT INTO member (firstname, lastname, age, gender, address, username, password)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                """, (firstname, lastname, age, gender, address, username, password))
                conn.commit()
                return True, "Member created successfully!"

        except sqlite3.Error as e:
            return False, f"Database error: {e}"

    def fetch_all_members(self):
        """Fetch all members from database"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("SELECT * FROM member ORDER BY lastname ASC")
                return cursor.fetchall()

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to fetch data: {e}")
            return []

    def delete_member(self, mem_id):
        """Delete a member by ID"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("DELETE FROM member WHERE mem_id = ?", (mem_id,))
                conn.commit()
                return cursor.rowcount > 0

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to delete member: {e}")
            return False

    def update_member(self, mem_id, firstname, lastname, age, gender, address, username, password):
        """Update a member's information"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                UPDATE member
                SET firstname=?, lastname=?, age=?, gender=?, address=?, username=?, password=?
                WHERE mem_id=?
                """, (firstname, lastname, age, gender, address, username, password, mem_id))
                conn.commit()
                return cursor.rowcount > 0

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to update member: {e}")
            return False


# ============================================================================
# CRUD APPLICATION CLASS
# ============================================================================

class CRUDApplication:
    """Main CRUD application"""

    def __init__(self, root):
        self.root = root
        self.root.title("Python: Simple CRUD Application")
        self.root.geometry("1300x700")
        self.root.resizable(True, True)

        self.db = DatabaseManager()
        self.selected_member_id = None

        # Initialize variables
        self.init_variables()

        # Build UI
        self.build_ui()

    def init_variables(self):
        """Initialize all StringVar variables"""
        self.id_var = tk.StringVar()
        self.firstname_var = tk.StringVar()
        self.lastname_var = tk.StringVar()
        self.age_var = tk.StringVar()
        self.gender_var = tk.StringVar()
        self.address_var = tk.StringVar()
        self.username_var = tk.StringVar()
        self.password_var = tk.StringVar()

    def build_ui(self):
        """Build the entire user interface"""

        # Top Frame - Title
        self.build_top_frame()

        # Main container with two columns
        main_container = ttk.Frame(self.root)
        main_container.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)

        # Left Frame - Form
        self.build_left_frame(main_container)

        # Right Frame - Table
        self.build_right_frame(main_container)

    def build_top_frame(self):
        """Build top frame with title"""
        top_frame = ttk.Frame(self.root)
        top_frame.pack(fill=tk.X, padx=5, pady=5)

        title = ttk.Label(
            top_frame,
            text="Python: Simple CRUD Application",
            font=("Arial", 20, "bold")
        )
        title.pack()

    def build_left_frame(self, parent):
        """Build left frame with form fields"""
        left_frame = ttk.LabelFrame(parent, text="Member Form", padding=10)
        left_frame.pack(side=tk.LEFT, fill=tk.BOTH, padx=5, pady=5, expand=False)

        ttk.Label(left_frame, text="ID:").grid(row=0, column=0, sticky=tk.W, pady=5)
        ttk.Entry(left_frame, textvariable=self.id_var, width=30).grid(row=0, column=1, pady=5)

        ttk.Label(left_frame, text="Firstname:").grid(row=1, column=0, sticky=tk.W, pady=5)
        ttk.Entry(left_frame, textvariable=self.firstname_var, width=30).grid(row=1, column=1, pady=5)

        ttk.Label(left_frame, text="Lastname:").grid(row=2, column=0, sticky=tk.W, pady=5)
        ttk.Entry(left_frame, textvariable=self.lastname_var, width=30).grid(row=2, column=1, pady=5)

        ttk.Label(left_frame, text="Age:").grid(row=3, column=0, sticky=tk.W, pady=5)
        age_values = tuple(range(1, 101))
        ttk.Combobox(left_frame, textvariable=self.age_var, values=age_values, width=28,
                     state="readonly").grid(row=3, column=1, pady=5)

        ttk.Label(left_frame, text="Gender:").grid(row=4, column=0, sticky=tk.W, pady=5)
        gender_frame = ttk.Frame(left_frame)
        gender_frame.grid(row=4, column=1, sticky=tk.W, pady=5)

        ttk.Radiobutton(gender_frame, text="Male", variable=self.gender_var,
                        value="Male").pack(side=tk.LEFT)
        ttk.Radiobutton(gender_frame, text="Female", variable=self.gender_var,
                        value="Female").pack(side=tk.LEFT)

        ttk.Label(left_frame, text="Address:").grid(row=5, column=0, sticky=tk.W, pady=5)
        ttk.Entry(left_frame, textvariable=self.address_var, width=30).grid(row=5, column=1, pady=5)

        ttk.Label(left_frame, text="Username:").grid(row=6, column=0, sticky=tk.W, pady=5)
        ttk.Entry(left_frame, textvariable=self.username_var, width=30).grid(row=6, column=1, pady=5)

        ttk.Label(left_frame, text="Password:").grid(row=7, column=0, sticky=tk.W, pady=5)
        ttk.Entry(left_frame, textvariable=self.password_var, show="*", width=30).grid(row=7, column=1, pady=5)

        self.status_label = ttk.Label(left_frame, text="", foreground="black", wraplength=250)
        self.status_label.grid(row=8, column=0, columnspan=2, sticky=tk.W, pady=10)

        button_frame = ttk.LabelFrame(left_frame, text="Actions", padding=10)
        button_frame.grid(row=9, column=0, columnspan=2, sticky=tk.EW, pady=10)

        ttk.Button(button_frame, text="Create", command=self.create_member, width=10).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Update", command=self.update_member, width=10).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Delete", command=self.delete_member, width=10).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Clear", command=self.clear_fields, width=10).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Exit", command=self.exit_app, width=10).pack(side=tk.LEFT, padx=5)

    def build_right_frame(self, parent):
        """Build right frame with data table"""
        right_frame = ttk.LabelFrame(parent, text="Members List", padding=5)
        right_frame.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True, padx=5, pady=5)

        columns = ("ID", "Firstname", "Lastname", "Age", "Gender", "Address", "Username", "Password")
        self.tree = ttk.Treeview(right_frame, columns=columns, height=25, show="headings")

        column_widths = {
            "ID": 40, "Firstname": 100, "Lastname": 100, "Age": 50,
            "Gender": 70, "Address": 150, "Username": 100, "Password": 100
        }

        for col in columns:
            self.tree.heading(col, text=col, anchor=tk.CENTER)
            self.tree.column(col, width=column_widths[col], minwidth=50, anchor=tk.CENTER)

        self.tree.bind("<ButtonRelease-1>", self.on_tree_select)

        v_scrollbar = ttk.Scrollbar(right_frame, orient=tk.VERTICAL, command=self.tree.yview)
        h_scrollbar = ttk.Scrollbar(right_frame, orient=tk.HORIZONTAL, command=self.tree.xview)

        self.tree.configure(yscroll=v_scrollbar.set, xscroll=h_scrollbar.set)

        self.tree.grid(row=0, column=0, sticky="nsew")
        v_scrollbar.grid(row=0, column=1, sticky="ns")
        h_scrollbar.grid(row=1, column=0, sticky="ew")

        right_frame.grid_rowconfigure(0, weight=1)
        right_frame.grid_columnconfigure(0, weight=1)

        self.read_members()

    def validate_fields(self):
        if not all([
            self.firstname_var.get().strip(),
            self.lastname_var.get().strip(),
            self.age_var.get(),
            self.gender_var.get(),
            self.address_var.get().strip(),
            self.username_var.get().strip(),
            self.password_var.get().strip()
        ]):
            self.show_status("Please complete all required fields!", "red")
            return False
        return True

    def create_member(self):
        if not self.validate_fields():
            return

        success, message = self.db.insert_member(
            self.firstname_var.get().strip(),
            self.lastname_var.get().strip(),
            self.age_var.get(),
            self.gender_var.get(),
            self.address_var.get().strip(),
            self.username_var.get().strip(),
            self.password_var.get().strip()
        )

        if success:
            self.show_status(message, "green")
            self.clear_fields()
            self.read_members()
        else:
            self.show_status(message, "red")

    def read_members(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        members = self.db.fetch_all_members()

        for member in members:
            self.tree.insert("", "end", values=member)

        self.show_status(f"Successfully loaded {len(members)} member(s)", "black")

    def update_member(self):
        if self.selected_member_id is None:
            self.show_status("Please select a member to update!", "red")
            return

        if not self.validate_fields():
            return

        success = self.db.update_member(
            self.selected_member_id,
            self.firstname_var.get().strip(),
            self.lastname_var.get().strip(),
            self.age_var.get(),
            self.gender_var.get(),
            self.address_var.get().strip(),
            self.username_var.get().strip(),
            self.password_var.get().strip()
        )

        if success:
            self.show_status("Member updated successfully!", "green")
            self.clear_fields()
            self.read_members()
        else:
            self.show_status("Failed to update member!", "red")

    def delete_member(self):
        if self.selected_member_id is None:
            self.show_status("Please select a member to delete!", "red")
            return

        if messagebox.askyesno("Confirm Delete", "Are you sure you want to delete this member?"):
            if self.db.delete_member(self.selected_member_id):
                self.show_status("Member deleted successfully!", "green")
                self.clear_fields()
                self.read_members()
            else:
                self.show_status("Failed to delete member!", "red")

    def on_tree_select(self, event):
        selection = self.tree.selection()

        if selection:
            item = self.tree.item(selection[0])
            values = item["values"]

            self.selected_member_id = values[0]

            self.firstname_var.set(values[1])
            self.lastname_var.set(values[2])
            self.age_var.set(values[3])
            self.gender_var.set(values[4])
            self.address_var.set(values[5])
            self.username_var.set(values[6])
            self.password_var.set(values[7])

    def clear_fields(self):
        self.id_var.set("")
        self.firstname_var.set("")
        self.lastname_var.set("")
        self.age_var.set("")
        self.gender_var.set("")
        self.address_var.set("")
        self.username_var.set("")
        self.password_var.set("")
        self.selected_member_id = None
        self.show_status("Fields cleared", "black")

    def show_status(self, message, color):
        self.status_label.config(text=message, foreground=color)

    def exit_app(self):
        if messagebox.askyesno("Exit", "Are you sure you want to exit?"):
            self.root.destroy()


if __name__ == "__main__":
    root = tk.Tk()
    app = CRUDApplication(root)
    root.mainloop()
