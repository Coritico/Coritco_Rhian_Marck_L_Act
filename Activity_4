import tkinter as tk
from tkinter import messagebox

def calculate_grade():
    try:
        no = entry_no.get()
        name = entry_name.get()
        course = entry_course.get()
        subject = entry_subject.get()
        prelim = float(entry_prelim.get())
        midterm = float(entry_midterm.get())
        final = float(entry_final.get())
        
        if prelim < 0 or midterm < 0 or final < 0:
            messagebox.showerror("Invalid Input", "Grades cannot be negative.")
            return
        
        average = ((prelim * 0.2) + (midterm * 0.3) + (final * 0.5))
        
        if average > 75:
            remark = "Passed"
        else:
            remark = "Failed"
        
        result_text.set(
            f"ID Number: {no}\n"
            f"Student: {name}\n"
            f"Course: {course}\n"
            f"Subject: {subject}\n"
            f"Prelim Grade: {prelim}\n"
            f"Midterm Grade: {midterm}\n"
            f"Final Grade: {final}\n"
            f"Average: {average:.2f}\n"
            f"Remark: {remark}"
        )
    except ValueError:
        messagebox.showerror("Invalid Input", "Please enter valid numeric grades.")

# Create main window
root = tk.Tk()
root.title("Student Grade Calculator")
root.geometry("500x600")

# Labels and Entry fields
tk.Label(root, text="ID Number").pack(pady=5)
entry_no = tk.Entry(root)
entry_no.pack()

tk.Label(root, text="Student Name").pack(pady=5)
entry_name = tk.Entry(root)
entry_name.pack()

tk.Label(root, text="Course").pack(pady=5)
entry_course = tk.Entry(root)
entry_course.pack()

tk.Label(root, text="Subject").pack(pady=5)
entry_subject = tk.Entry(root)
entry_subject.pack()

tk.Label(root, text="Prelim Grade").pack(pady=5)
entry_prelim = tk.Entry(root)
entry_prelim.pack()

tk.Label(root, text="Midterm Grade").pack(pady=5)
entry_midterm = tk.Entry(root)
entry_midterm.pack()

tk.Label(root, text="Final Grade").pack(pady=5)
entry_final = tk.Entry(root)
entry_final.pack()

# Button
tk.Button(root, text="Calculate Grade", command=calculate_grade).pack(pady=15)

# Result display
result_text = tk.StringVar()
tk.Label(root, textvariable=result_text, fg="blue", justify="left").pack(pady=10)

# Run application
root.mainloop()
