import tkinter as tk
from tkinter import ttk, messagebox

def compute_and_get_data():
    """Validates inputs, calculates grades, and returns full data row."""
    try:
        sid, name, course, subj = entry_id.get(), entry_name.get(), combo_course.get(), entry_subject.get()
        if not (sid and name and course and subj):
            messagebox.showerror("Error", "Fill in all student details.")
            return None

        p, m, f = float(entry_prelim.get()), float(entry_midterm.get()), float(entry_final.get())
        if not (0 <= p <= 100 and 0 <= m <= 100 and 0 <= f <= 100):
            messagebox.showerror("Error", "Grades must be 0-100.")
            return None

        # Weighted Formula: 30% Prelim, 30% Midterm, 40% Final
        average = (p * 0.30) + (m * 0.30) + (f * 0.40)
        avg = round(average)
        
        if avg >= 97: num, rem = "1.00", "Excellent"
        elif avg >= 94: num, rem = "1.25", "Excellent"
        elif avg >= 91: num, rem = "1.50", "Very Good"
        elif avg >= 88: num, rem = "1.75", "Very Good"
        elif avg >= 85: num, rem = "2.00", "Above Average"
        elif avg >= 82: num, rem = "2.25", "Above Average"
        elif avg >= 79: num, rem = "2.50", "Average"
        elif avg >= 76: num, rem = "2.75", "Average"
        elif avg >= 75: num, rem = "3.00", "Passing"
        elif avg >= 72: num, rem = "3.25", "Conditional"
        elif avg >= 69: num, rem = "3.50", "Conditional"
        elif avg >= 66: num, rem = "3.75", "Failed"
        elif avg >= 65: num, rem = "4.00", "Failed"
        else: num, rem = "5.00", "Failed"

        return [sid, name, course, subj, p, m, f, f"{average:.2f}", num, rem]
    except ValueError:
        messagebox.showerror("Error", "Enter numeric values for grades.")
        return None

def compute_and_add():
    data = compute_and_get_data()
    if data:
        tree.insert("", "end", values=data)
        clear_inputs()

def update_record():
    selected = tree.selection()
    if not selected:
        messagebox.showwarning("Update Error", "Please click a record in the table first.")
        return
    
    new_data = compute_and_get_data()
    if new_data:
        tree.item(selected, values=new_data)
        messagebox.showinfo("Success", "Record updated successfully.")
        clear_inputs()

def delete_record():
    selected = tree.selection()
    if selected:
        if messagebox.askyesno("Confirm", "Are you sure you want to delete this record?"):
            tree.delete(selected)
            clear_inputs()
    else:
        messagebox.showwarning("Selection", "Select a record.")

def clear_inputs():
    for e in [entry_id, entry_name, entry_subject, entry_prelim, entry_midterm, entry_final]:
        e.delete(0, tk.END)
    combo_course.set('')
    tree.selection_remove(tree.selection())
    selection_label.config(text="Status: Ready to Add New Record", fg="#7f8c8d")

def fill_inputs_on_select(event):
    """Event triggered when a row is clicked/selected."""
    selected = tree.selection()
    if selected:
        values = tree.item(selected)['values']
        # Clear fields before re-populating
        for e in [entry_id, entry_name, entry_subject, entry_prelim, entry_midterm, entry_final]:
            e.delete(0, tk.END)
            
        entry_id.insert(0, values[0])
        entry_name.insert(0, values[1])
        combo_course.set(values[2])
        entry_subject.insert(0, values[3])
        entry_prelim.insert(0, values[4])
        entry_midterm.insert(0, values[5])
        entry_final.insert(0, values[6])
        
        selection_label.config(text=f"Selected: Student ID {values[0]}", fg="#2980b9")

# --- GUI Setup ---
