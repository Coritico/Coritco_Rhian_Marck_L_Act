# Action Buttons
btn_sub_frame = tk.Frame(input_frame, bg="white")
btn_sub_frame.grid(row=3, column=3, sticky="e", pady=5)
tk.Button(btn_sub_frame, text="ADD", command=compute_and_add, bg="#27ae60", fg="white", width=8, relief="flat").pack(side="left", padx=2)
tk.Button(btn_sub_frame, text="UPDATE", command=update_record, bg="#2980b9", fg="white", width=8, relief="flat").pack(side="left", padx=2)
tk.Button(btn_sub_frame, text="CLEAR", command=clear_inputs, bg="#95a5a6", fg="white", width=8, relief="flat").pack(side="left", padx=2)

# Table Section
table_frame = tk.Frame(root)
table_frame.pack(fill="both", expand=True, padx=20, pady=5)

columns = ("ID", "Name", "Course", "Subject", "Prelim", "Midterm", "Final", "Average", "Numerical", "Remark")
tree = ttk.Treeview(table_frame, columns=columns, show="headings", height=10)

# Selection Style
style = ttk.Style()
style.theme_use("default")
style.map("Treeview", background=[('selected', '#d1e7ff')], foreground=[('selected', 'black')])

for col in columns:
    tree.heading(col, text=col)
    tree.column(col, width=90, anchor="center")

tree.pack(side="left", fill="both", expand=True)
tree.bind("<<TreeviewSelect>>", fill_inputs_on_select)

scrollbar = ttk.Scrollbar(table_frame, orient="vertical", command=tree.yview)
tree.configure(yscroll=scrollbar.set)
scrollbar.pack(side="right", fill="y")

