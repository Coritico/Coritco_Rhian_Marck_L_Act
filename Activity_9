class LoginWindow:
    def __init__(self, on_success):
        self.on_success = on_success
        self.root = tk.Tk()
        self.root.title("System Login")
        self.root.geometry("350x250")
        self.root.resizable(False, False)
        self.root.configure(bg="#f0f2f5")

        # Center the window
        self.root.eval('tk::PlaceWindow . center')

        tk.Label(
            self.root, 
            text="SECURITY ACCESS", 
            font=("Segoe UI", 14, "bold"), 
            bg="#f0f2f5", 
            fg="#1f2937"
        ).pack(pady=20)

        # Form Container
        frame = tk.Frame(self.root, bg="#f0f2f5")
        frame.pack(padx=20)

        tk.Label(frame, text="Username:", bg="#f0f2f5", font=("Segoe UI", 10)).grid(row=0, column=0, sticky="w")
        self.user_ent = tk.Entry(frame, width=25, font=("Segoe UI", 10))
        self.user_ent.grid(row=0, column=1, pady=5)

        tk.Label(frame, text="Password:", bg="#f0f2f5", font=("Segoe UI", 10)).grid(row=1, column=0, sticky="w")
        self.pass_ent = tk.Entry(frame, width=25, font=("Segoe UI", 10), show="*")
        self.pass_ent.grid(row=1, column=1, pady=5)

        # Login Button
        tk.Button(
            self.root, 
            text="LOGIN", 
            command=self.validate, 
            bg="#1f2937", 
            fg="white", 
            font=("Segoe UI", 10, "bold"),
            width=15,
            cursor="hand2"
        ).pack(pady=20)

        self.root.mainloop()

    def validate(self):
        u = self.user_ent.get()
        p = self.pass_ent.get()

        if u == USERNAME and p == PASSWORD:
            self.root.destroy()
            self.on_success()
        else:
            messagebox.showerror("Login Failed", "Invalid username or password.")

