    def compute_payroll(self):
        try:
            rate_per_day = float(self.rate_per_day_var.get())
            days_worked = float(self.days_worked_var.get())
            sss = float(self.sss_var.get()) if self.sss_var.get() else 0
            philhealth = float(self.philhealth_var.get()) if self.philhealth_var.get() else 0
            cash_advance = float(self.cash_advance_var.get()) if self.cash_advance_var.get() else 0

            gross_pay = rate_per_day * days_worked
            total_deductions = sss + philhealth + cash_advance
            net_pay = gross_pay - total_deductions

            self.gross_pay_var.set(f"{gross_pay:,.2f}")
            self.total_deductions_var.set(f"{total_deductions:,.2f}")
            self.net_pay_var.set(f"{net_pay:,.2f}")

            self.show_status("Payroll computed successfully!")
        except Exception as e:
            self.show_status(f"Computation Error: {str(e)}")

    def save_record(self):
        try:
            rate_per_day = float(self.rate_per_day_var.get())
            days_worked = float(self.days_worked_var.get())
            sss = float(self.sss_var.get()) if self.sss_var.get() else 0
            philhealth = float(self.philhealth_var.get()) if self.philhealth_var.get() else 0
            cash_advance = float(self.cash_advance_var.get()) if self.cash_advance_var.get() else 0

            gross_pay = rate_per_day * days_worked
            total_deductions = sss + philhealth + cash_advance
            net_pay = gross_pay - total_deductions

            success, message = self.db.insert_payroll_record(
                self.emp_number_var.get().strip(),
                self.emp_name_var.get().strip(),
                self.gender_var.get(),
                self.job_position_var.get(),
                rate_per_day,
                days_worked,
                gross_pay,
                sss,
                philhealth,
                cash_advance,
                total_deductions,
                net_pay
            )

            if success:
                self.show_status(message)
                self.clear_fields()
                self.read_records()
            else:
                self.show_status(message)
        except Exception as e:
            self.show_status(f"Error saving record: {str(e)}")

    def read_records(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        records = self.db.fetch_all_records()

        for record in records:
            formatted_record = (
                record[0], record[1], record[2], record[3], record[4],
                f"{record[5]:,.2f}", f"{record[6]:.0f}", f"{record[7]:,.2f}",
                f"{record[8]:,.2f}", f"{record[9]:,.2f}", f"{record[10]:,.2f}",
                f"{record[11]:,.2f}", f"{record[12]:,.2f}", record[13]
            )
            self.tree.insert("", "end", values=formatted_record)

        self.show_status(f"Loaded {len(records)} payroll record(s)")

