    def new_file(self):
        """Create new file"""
        self.editor.delete("1.0", tk.END)
        self.editor.insert(tk.END, "# New Python File\n")
        self.current_file = None
        self.update_status("New file created")
        
    def open_file(self):
        """Open file"""
        filename = filedialog.askopenfilename(
            title="Open File",
            filetypes=[("Python Files", "*.py"), ("Text Files", "*.txt"), ("All Files", "*.*")]
        )
        
        if filename:
            try:
                with open(filename, "r", encoding="utf-8") as f:
                    content = f.read()
                self.editor.delete("1.0", tk.END)
                self.editor.insert(tk.END, content)
                self.current_file = filename
                self.update_status(f"Opened: {Path(filename).name}")
            except Exception as e:
                self.update_status(f"Error opening file: {str(e)}")
                
    def save_file(self):
        """Save file"""
        if self.current_file:
            filename = self.current_file
        else:
            filename = filedialog.asksaveasfilename(
                defaultextension=".py",
                filetypes=[("Python Files", "*.py"), ("Text Files", "*.txt"), ("All Files", "*.*")]
            )
        
        if filename:
            try:
                with open(filename, "w", encoding="utf-8") as f:
                    f.write(self.editor.get("1.0", tk.END))
                self.current_file = filename
                self.update_status(f"Saved: {Path(filename).name}")
            except Exception as e:
                self.update_status(f"Error saving file: {str(e)}")
                
    def clear_output(self):
        """Clear output"""
        self.output.config(state=tk.NORMAL)
        self.output.delete("1.0", tk.END)
        self.output.config(state=tk.DISABLED)
        self.update_status("Output cleared")
        
    def run_code(self):
        """Run Python code"""
        code = self.editor.get("1.0", tk.END)
        
        output_buffer = io.StringIO()
        old_stdout = sys.stdout
        old_stderr = sys.stderr
        
        sys.stdout = output_buffer
        sys.stderr = output_buffer
        
        try:
            exec(code, {"__builtins__": __builtins__})
            self.update_status("Code executed successfully")
        except Exception as e:
            print(f"ERROR: {type(e).__name__}: {e}")
            self.update_status("Code execution failed - see output")
        finally:
            sys.stdout = old_stdout
            sys.stderr = old_stderr
            self.display_output(output_buffer.getvalue())
            
    def display_output(self, text):
        """Display output in terminal"""
        self.output.config(state=tk.NORMAL)
        self.output.delete("1.0", tk.END)
        self.output.insert(tk.END, text if text else "No output")
        self.output.config(state=tk.DISABLED)
        
    def update_status(self, message):
        """Update status bar"""
        self.status_var.set(message)
        
