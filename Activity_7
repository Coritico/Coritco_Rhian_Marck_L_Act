    def validate_fields(self):
        """Validate all input fields"""
        if not self.emp_number_var.get().strip():
            self.show_status("Please enter Employee Number!")
            return False

        if not self.emp_name_var.get().strip():
            self.show_status("Please enter Employee Name!")
            return False

        if not self.gender_var.get():
            self.show_status("Please select Gender!")
            return False

        if not self.job_position_var.get():
            self.show_status("Please select Job Position!")
            return False

        # Validate Rate per Day
        try:
            rate = float(self.rate_per_day_var.get())
            if rate < 0:
                raise ValueError("Rate cannot be negative")
        except ValueError:
            self.show_status("Please enter valid Rate per Day!")
            return False

        # Validate Days Worked
        try:
            days = float(self.days_worked_var.get())
            if days < 0:
                raise ValueError("Days worked cannot be negative")
        except ValueError:
            self.show_status("Please enter valid Days Worked!")
            return False

        # Validate Deductions
        try:
            sss = float(self.sss_var.get()) if self.sss_var.get() else 0
            philhealth = float(self.philhealth_var.get()) if self.philhealth_var.get() else 0
            cash_advance = float(self.cash_advance_var.get()) if self.cash_advance_var.get() else 0

            if sss < 0 or philhealth < 0 or cash_advance < 0:
                raise ValueError("Deductions cannot be negative")
        except ValueError:
            self.show_status("Please enter valid deduction amounts!")
            return False

        return True

    def compute_payroll(self):
        """Compute payroll based on input values"""
        if not self.validate_fields():
            return

        try:
            # Get input values
            rate_per_day = float(self.rate_per_day_var.get())
            days_worked = float(self.days_worked_var.get())
            sss = float(self.sss_var.get()) if self.sss_var.get() else 0
            philhealth = float(self.philhealth_var.get()) if self.philhealth_var.get() else 0
            cash_advance = float(self.cash_advance_var.get()) if self.cash_advance_var.get() else 0

            # Compute Gross Pay
            gross_pay = rate_per_day * days_worked

            # Compute Total Deductions
            total_deductions = sss + philhealth + cash_advance

            # Compute Net Pay
            net_pay = gross_pay - total_deductions

            # Display results
            self.gross_pay_var.set(f"{gross_pay:,.2f}")
            self.total_deductions_var.set(f"{total_deductions:,.2f}")
            self.net_pay_var.set(f"{net_pay:,.2f}")

            self.show_status("Payroll computed successfully! Click 'Save Record' to store.")

        except Exception as e:
            self.show_status(f"Computation Error: {str(e)}")

    def save_record(self):
        """Save the payroll record to database"""
        if not self.validate_fields():
            return

        try:
            # Get input values
            rate_per_day = float(self.rate_per_day_var.get())
            days_worked = float(self.days_worked_var.get())
            sss = float(self.sss_var.get()) if self.sss_var.get() else 0
            philhealth = float(self.philhealth_var.get()) if self.philhealth_var.get() else 0
            cash_advance = float(self.cash_advance_var.get()) if self.cash_advance_var.get() else 0

            # Compute values
            gross_pay = rate_per_day * days_worked
            total_deductions = sss + philhealth + cash_advance
            net_pay = gross_pay - total_deductions

            # Save to database
            success, message = self.db.insert_payroll_record(
                self.user_id,
                self.emp_number_var.get().strip(),
                self.emp_name_var.get().strip(),
                self.gender_var.get(),
                self.job_position_var.get(),
                rate_per_day,
                days_worked,
                gross_pay,
                sss,
                philhealth,
                cash_advance,
                total_deductions,
                net_pay
            )

            if success:
                self.show_status(message)
                self.clear_fields()
                self.read_records()
            else:
                self.show_status(message)

        except Exception as e:
            self.show_status(f"Error saving record: {str(e)}")

    def read_records(self):
        """Read and display all payroll records from database"""
        for item in self.tree.get_children():
            self.tree.delete(item)

        records = self.db.fetch_all_records(self.user_id)

        for record in records:
            # Format the values for display
            formatted_record = (
                record[0],  # ID
                record[1],  # Emp Number
                record[2],  # Emp Name
                record[3],  # Gender
                record[4],  # Job Position
                f"{record[5]:,.2f}",  # Rate per Day
                f"{record[6]:.0f}",  # Days Worked
                f"{record[7]:,.2f}",  # Gross Pay
                f"{record[8]:,.2f}",  # SSS
                f"{record[9]:,.2f}",  # PhilHealth
                f"{record[10]:,.2f}",  # Cash Advance
                f"{record[11]:,.2f}",  # Total Deductions
                f"{record[12]:,.2f}",  # Net Pay
                record[13]  # Date
            )
            self.tree.insert("", "end", values=formatted_record)

        self.show_status(f"Loaded {len(records)} payroll record(s)")

    def on_tree_select(self, event):
        """Handle tree selection"""
        selection = self.tree.selection()

        if selection:
            item = self.tree.item(selection[0])
            values = item["values"]

            self.selected_record_id = values[0]

            # Parse values and set variables (removing formatting)
            self.emp_number_var.set(values[1])
            self.emp_name_var.set(values[2])
            self.gender_var.set(values[3])
            self.job_position_var.set(values[4])
            self.rate_per_day_var.set(values[5].replace(",", ""))
            self.days_worked_var.set(values[6])
            self.sss_var.set(values[8].replace(",", ""))
            self.philhealth_var.set(values[9].replace(",", ""))
            self.cash_advance_var.set(values[10].replace(",", ""))
            
            self.gross_pay_var.set(values[7])
            self.total_deductions_var.set(values[11])
            self.net_pay_var.set(values[12])

    def update_record(self):
        """Update selected payroll record"""
        if self.selected_record_id is None:
            self.show_status("Please select a record to update!")
            return

        if not self.validate_fields():
            return

        try:
            rate_per_day = float(self.rate_per_day_var.get())
            days_worked = float(self.days_worked_var.get())
            sss = float(self.sss_var.get()) if self.sss_var.get() else 0
            philhealth = float(self.philhealth_var.get()) if self.philhealth_var.get() else 0
            cash_advance = float(self.cash_advance_var.get()) if self.cash_advance_var.get() else 0

            gross_pay = rate_per_day * days_worked
            total_deductions = sss + philhealth + cash_advance
            net_pay = gross_pay - total_deductions

            success = self.db.update_record(
                self.selected_record_id,
                self.emp_number_var.get().strip(),
                self.emp_name_var.get().strip(),
                self.gender_var.get(),
                self.job_position_var.get(),
                rate_per_day,
                days_worked,
                gross_pay,
                sss,
                philhealth,
                cash_advance,
                total_deductions,
                net_pay
            )

            if success:
                self.show_status("Record updated successfully!")
                self.clear_fields()
                self.read_records()
            else:
                self.show_status("Failed to update record!")

        except Exception as e:
            self.show_status(f"Error updating record: {str(e)}")

    def delete_record(self):
        """Delete selected payroll record"""
        if self.selected_record_id is None:
            self.show_status("Please select a record to delete!")
            return

        if messagebox.askyesno("Confirm Delete", "Are you sure you want to delete this record?"):
            if self.db.delete_record(self.selected_record_id):
                self.show_status("Record deleted successfully!")
                self.clear_fields()
                self.read_records()
            else:
                self.show_status("Failed to delete record!")

    def clear_fields(self):
        """Clear all fields"""
        self.emp_number_var.set("")
        self.emp_name_var.set("")
        self.gender_var.set("")
        self.job_position_var.set("")
        self.rate_per_day_var.set("")
        self.days_worked_var.set("")
        self.sss_var.set("0.00")
        self.philhealth_var.set("0.00")
        self.cash_advance_var.set("0.00")
        self.gross_pay_var.set("0.00")
        self.total_deductions_var.set("0.00")
        self.net_pay_var.set("0.00")
        self.selected_record_id = None
        self.show_status("Fields cleared")

    def show_status(self, message):
        """Display status message"""
        self.status_label.config(text=message)

    def logout_app(self):
        """Logout and return to login window"""
        if messagebox.askyesno("Logout", "Are you sure you want to logout?"):
            self.root.destroy()
            main()

    def exit_app(self):
        """Exit the application"""
        if messagebox.askyesno("Exit", "Are you sure you want to exit?"):
            self.root.destroy()
            exit()


def open_payroll_system(user_id, user_email):
    """Open the payroll system window"""
    app_root = tk.Tk()
    app = PayrollSystem(app_root, user_id, user_email)
    app_root.mainloop()


def main():
    """Main entry point"""
    login_root = tk.Tk()
    db = DatabaseManager()
    login_window = LoginWindow(login_root, db, callback=open_payroll_system)
    login_root.mainloop()

    # If user logged in successfully, the callback will handle opening payroll system
    # This prevents issues with the event loop


if __name__ == "__main__":
    main()
