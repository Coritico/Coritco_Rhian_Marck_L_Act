class DatabaseManager:
    """Handles all database operations for payroll system"""

    def __init__(self, db_name="payroll_system.db"):
        self.db_name = db_name
        self.init_database()

    def init_database(self):
        """Initialize database and create table if it doesn't exist"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()

                # Create users table
                cursor.execute("""
                CREATE TABLE IF NOT EXISTS users (
                    user_id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
                    email TEXT NOT NULL UNIQUE,
                    password TEXT NOT NULL,
                    created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
                """)

                # Create payroll records table
                cursor.execute("""
                CREATE TABLE IF NOT EXISTS payroll_records (
                    record_id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
                    user_id INTEGER NOT NULL,
                    emp_number TEXT NOT NULL,
                    emp_name TEXT NOT NULL,
                    gender TEXT NOT NULL,
                    job_position TEXT NOT NULL,
                    rate_per_day REAL NOT NULL,
                    days_worked REAL NOT NULL,
                    gross_pay REAL NOT NULL,
                    sss REAL NOT NULL,
                    philhealth REAL NOT NULL,
                    cash_advance REAL NOT NULL,
                    total_deductions REAL NOT NULL,
                    net_pay REAL NOT NULL,
                    computation_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY(user_id) REFERENCES users(user_id)
                )
                """)
                conn.commit()

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to initialize database: {e}")

    def register_user(self, email, password):
        """Register a new user"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                INSERT INTO users (email, password)
                VALUES (?, ?)
                """, (email, password))
                conn.commit()
                return True, "Registration successful! Please log in."

        except sqlite3.IntegrityError:
            return False, "Email already registered!"
        except sqlite3.Error as e:
            return False, f"Database error: {e}"

    def login_user(self, email, password):
        """Authenticate user login"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                SELECT user_id, email FROM users WHERE email = ? AND password = ?
                """, (email, password))
                result = cursor.fetchone()
                
                if result:
                    return True, result[0], result[1]
                else:
                    return False, None, None

        except sqlite3.Error as e:
            return False, None, f"Database error: {e}"

    def insert_payroll_record(self, user_id, emp_number, emp_name, gender, job_position, rate_per_day, 
                             days_worked, gross_pay, sss, philhealth, cash_advance, 
                             total_deductions, net_pay):
        """Insert a new payroll record into the database"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                INSERT INTO payroll_records 
                (user_id, emp_number, emp_name, gender, job_position, rate_per_day, days_worked, 
                 gross_pay, sss, philhealth, cash_advance, total_deductions, net_pay)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """, (user_id, emp_number, emp_name, gender, job_position, rate_per_day, days_worked, 
                      gross_pay, sss, philhealth, cash_advance, total_deductions, net_pay))
                conn.commit()
                return True, "Payroll record saved successfully!"

        except sqlite3.Error as e:
            return False, f"Database error: {e}"

    def fetch_all_records(self, user_id):
        """Fetch all payroll records for a user from database"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                SELECT record_id, emp_number, emp_name, gender, job_position, rate_per_day, 
                       days_worked, gross_pay, sss, philhealth, cash_advance, total_deductions, 
                       net_pay, computation_date 
                FROM payroll_records 
                WHERE user_id = ?
                ORDER BY computation_date DESC
                """, (user_id,))
                return cursor.fetchall()

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to fetch data: {e}")
            return []

    def delete_record(self, record_id):
        """Delete a payroll record by ID"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("DELETE FROM payroll_records WHERE record_id = ?", (record_id,))
                conn.commit()
                return cursor.rowcount > 0

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to delete record: {e}")
            return False

    def update_record(self, record_id, emp_number, emp_name, gender, job_position, rate_per_day, 
                     days_worked, gross_pay, sss, philhealth, cash_advance, total_deductions, net_pay):
        """Update a payroll record"""
        try:
            with sqlite3.connect(self.db_name) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                UPDATE payroll_records
                SET emp_number=?, emp_name=?, gender=?, job_position=?, rate_per_day=?, 
                    days_worked=?, gross_pay=?, sss=?, philhealth=?, cash_advance=?, 
                    total_deductions=?, net_pay=?
                WHERE record_id=?
                """, (emp_number, emp_name, gender, job_position, rate_per_day, days_worked, 
                      gross_pay, sss, philhealth, cash_advance, total_deductions, net_pay, record_id))
                conn.commit()
                return cursor.rowcount > 0

        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to update record: {e}")
            return False


class LoginWindow:
    """Login and Registration Window"""

    def __init__(self, root, db, callback=None):
        self.root = root
        self.db = db
        self.callback = callback
        self.user_id = None
        self.user_email = None
        self.is_logged_in = False

        self.root.title("Payroll System - Login")
        self.root.geometry("400x350")
        self.root.resizable(False, False)

        self.build_ui()

    def build_ui(self):
        """Build login UI"""
        main_frame = ttk.Frame(self.root, padding=20)
        main_frame.pack(fill=tk.BOTH, expand=True)

        # Title
        title = ttk.Label(main_frame, text="Payroll System Login", font=("Arial", 18, "bold"))
        title.pack(pady=10)

        # Email
        ttk.Label(main_frame, text="Email:", font=("Arial", 10)).pack(anchor=tk.W, pady=5)
        self.email_var = tk.StringVar()
        ttk.Entry(main_frame, textvariable=self.email_var, width=40).pack(fill=tk.X, pady=5)

        # Password
        ttk.Label(main_frame, text="Password:", font=("Arial", 10)).pack(anchor=tk.W, pady=5)
        self.password_var = tk.StringVar()
        ttk.Entry(main_frame, textvariable=self.password_var, show="*", width=40).pack(fill=tk.X, pady=5)

        # Status Label
        self.status_label = ttk.Label(main_frame, text="", font=("Arial", 9))
        self.status_label.pack(pady=10)

        # Buttons Frame
        button_frame = ttk.Frame(main_frame)
        button_frame.pack(fill=tk.X, pady=20)

        ttk.Button(button_frame, text="Login", command=self.login, width=12).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Register", command=self.register, width=12).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Exit", command=self.exit_app, width=12).pack(side=tk.LEFT, padx=5)

    def login(self):
        """Handle login"""
        email = self.email_var.get().strip()
        password = self.password_var.get().strip()

        if not email or not password:
            self.status_label.config(text="Please enter email and password")
            return

        success, user_id, result = self.db.login_user(email, password)

        if success:
            self.user_id = user_id
            self.user_email = email
            self.is_logged_in = True
            self.root.destroy()
            
            # Call callback if provided to open payroll system
            if self.callback:
                self.callback(user_id, email)
        else:
            self.status_label.config(text="Invalid email or password")

    def register(self):
        """Handle registration"""
        email = self.email_var.get().strip()
        password = self.password_var.get().strip()

        if not email or not password:
            self.status_label.config(text="Please enter email and password")
            return

        if len(password) < 4:
            self.status_label.config(text="Password must be at least 4 characters")
            return

        success, message = self.db.register_user(email, password)
        self.status_label.config(text=message)

        if success:
            self.email_var.set("")
            self.password_var.set("")

    def exit_app(self):
        """Exit application"""
        if messagebox.askyesno("Exit", "Are you sure you want to exit?"):
            self.root.destroy()
            exit()


